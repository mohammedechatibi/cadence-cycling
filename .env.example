# Copy to .env and fill in. Never commit .env.

# Public URL of the site. Used for Stripe success/cancel URLs and email links.
APP_URL=http://localhost:3000

# SQLite file (optional, default ./data/app.db)
# DATABASE_URL=./data/app.db

# Stripe (use sk_test_... keys while developing)
STRIPE_SECRET_KEY=
# From the webhook endpoint in the Stripe dashboard, or `stripe listen`
STRIPE_WEBHOOK_SECRET=

# SMTP (defaults to localhost:1025, e.g. a local Mailpit/MailHog)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Cadence <no-reply@example.com>"

# Receives a "New sale" email for each paid order (optional)
ADMIN_EMAIL=
